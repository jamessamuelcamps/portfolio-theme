---
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingCard from '../components/WritingCard.astro';
import { getCollection } from 'astro:content';

const allWriting = await getCollection('writing');
const recentWriting = allWriting
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const fullBleed = recentWriting.length === 0;
---

<BaseLayout fullBleed={fullBleed}>
  <div class="container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-main">
        <p class="availability-pill">Available for new opportunities. Let’s talk →</p>
        <h1 class="hero-quote">
          <span>“I’d rather he didn’t come back at all. His trainers are shit and he’s too tall. No-one even likes him.”</span>
        </h1>
        <p class="hero-cite">— Design Director, VML</p>
      </div>

      <div class="hero-bottom">
        <div class="hero-bio">
          <p>
            I specialise in complex B2B/B2C fintech infrastructure, design systems, and product velocity. I build scalable frameworks and UI architecture that help product teams ship better software, faster.
          </p>
          <p>
            I’m also building <a href="https://github.com/jamessamuelcamps/tilia" target="_blank" rel="noopener noreferrer" class="highlight-link">Tilia</a>, a free UX research platform for solo practitioners, small product teams, and founders.
          </p>
        </div>

        <div class="hero-social">
          <a href="https://www.linkedin.com/in/jamessc/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://www.instagram.com/james_sc/" target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
      </div>

      <a
        class="hero-mark"
        href="https://github.com/jamessamuelcamps/portfolio-theme"
        target="_blank"
        rel="noopener noreferrer"
      ><span>Steal this theme <span class="arrow" aria-hidden="true">→</span></span></a>
    </section>

    <!-- Writing Section -->
    {recentWriting.length > 0 && (
      <section class="section" id="writing">
        <div class="section-header">
          <div>
            <h2 class="section-title">Writing & Insights</h2>
            <p class="section-description">Thoughts on design engineering, system architecture, and UX methodologies.</p>
          </div>
          <a href="/writing" class="section-link">View All Writing →</a>
        </div>

        <div class="writing-list">
          {recentWriting.map((post) => (
            <WritingCard post={post} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding: var(--space-8) 0 var(--space-12);
  }

  .availability-pill {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    font-size: var(--font-size-xs);
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  .hero-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1144px;
  }

  .hero-quote {
    font-size: var(--font-size-4xl);
    /* Looser than line-height-tight so the stacked highlight fragments
       don't overlap. */
    line-height: 1.6;
    letter-spacing: -0.05em;
    margin-bottom: var(--space-8);
  }

  /* Per-line highlight — same treatment as the case-study card title:
     text-colour background, page-colour glyphs, one fragment per line. */
  .hero-quote span {
    display: inline;
    background-color: var(--color-text);
    color: var(--color-bg);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0.12em 0.3em;
    margin-left: -0.3em;
  }

  @media (min-width: 768px) {
    .hero-quote {
      font-size: var(--font-size-7xl);
    }
  }

  .hero-cite {
    font-size: var(--font-size-xl);
    color: var(--color-text);
  }

  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .hero-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .hero-bio {
    max-width: 560px;
    font-size: var(--font-size-base);
    color: var(--color-text);
  }

  .hero-bio p + p {
    margin-top: var(--space-4);
  }

  .highlight-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: var(--font-weight-medium);
  }

  .highlight-link:hover {
    color: var(--color-text-secondary);
  }

  .hero-social {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text);
    text-align: right;
  }

  .hero-social a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-mark {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    display: none;
  }

  /* Direct child only — a bare `.hero-mark span` also matches the nested
     .arrow span and hands it the 180° rotation, which the hover transform
     then strips (making the arrow flip). */
  .hero-mark > span {
    display: inline-block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .hero-mark:hover > span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Same nudge as the work-index card arrow. The label is vertical and
     rotated 180°, so a local +Y translate moves the arrow the way it
     points (upward on screen). */
  .hero-mark .arrow {
    display: inline-block;
    transition: transform var(--transition-base);
  }

  .hero-mark:hover .arrow {
    transform: translateY(3px);
  }

  @media (min-width: 1024px) {
    .hero-mark {
      display: block;
    }
  }

  .section {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .section-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .section-title {
    margin-bottom: var(--space-1);
  }

  .section-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .section-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    white-space: nowrap;
  }

  .section-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .writing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
