---
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingCard from '../components/WritingCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getCollection } from 'astro:content';

const allWriting = await getCollection('writing');
const recentWriting = allWriting
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const fullBleed = recentWriting.length === 0;
---

<BaseLayout fullBleed={fullBleed}>
  <div class="container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-main">
        <p class="availability-pill">Available. Let’s talk.</p>
        <h1 class="display-quote">
          <span>“I’d rather he didn’t come back at all. His trainers are shit and he’s too tall. No-one even likes him.”</span>
        </h1>
        <p class="display-quote-cite">— Design Director, VML</p>
      </div>

      <div class="hero-bottom">
        <div class="hero-bio">
          <p>
            I specialise in complex B2B/B2C fintech infrastructure, design systems, and product velocity. I build scalable frameworks and UI architecture that help product teams ship better software, faster.
          </p>
          <p>
            I’m also building <a href="https://tilialabs.io" target="_blank" rel="noopener noreferrer" class="highlight-link">Tilia</a>, a free UX research platform for solo practitioners, small product teams, and founders.
          </p>
        </div>

        <SocialLinks class="hero-social" emailLabel="Email" variant="column" />
      </div>

      <a
        class="hero-mark"
        href="https://github.com/jamessamuelcamps/portfolio-theme"
        target="_blank"
        rel="noopener noreferrer"
      ><span>Steal this theme</span></a>
    </section>

    <!-- Writing Section -->
    {recentWriting.length > 0 && (
      <section class="section" id="writing">
        <div class="section-header">
          <div>
            <h2 class="section-title">Writing & Insights</h2>
            <p class="section-description">Thoughts on design engineering, system architecture, and UX methodologies.</p>
          </div>
          <a href="/writing" class="section-link marker-link">View All Writing →</a>
        </div>

        <div class="writing-list">
          {recentWriting.map((post) => (
            <WritingCard post={post} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding: var(--space-8) 0 var(--space-12);
  }

  .availability-pill {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    font-size: var(--font-size-xs);
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  .hero-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1144px;
  }

  /* Display quote + cite type live in global.css (.display-quote /
     .display-quote-cite) so the homepage and About page stay in sync. */

  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .hero-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .hero-bio {
    max-width: 560px;
    font-size: var(--font-size-base);
    color: var(--color-text);
  }

  .hero-bio p + p {
    margin-top: var(--space-4);
  }

  .highlight-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: var(--font-weight-medium);
  }

  .highlight-link:hover {
    color: var(--color-text-secondary);
  }

  .hero-mark {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    display: none;
  }

  .hero-mark > span {
    display: inline-block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    padding: 0.15em 0.3em;
    /* Marker sweep: a text-colour highlight grows from the start of the label
       (screen-bottom, after the 180° rotation) to the end on hover, glyphs
       flipping to the page colour — the inverted highlight from the hero quote
       and card titles, revealed like a marker stroke. */
    background-image: linear-gradient(var(--color-text), var(--color-text));
    background-repeat: no-repeat;
    background-position: 50% 0;
    background-size: 100% 0%;
    transition: background-size var(--transition-base), color var(--transition-base);
  }

  /* Also overrides the global `a:hover` underline on the anchor itself. */
  .hero-mark:hover,
  .hero-mark:focus-visible {
    text-decoration: none;
  }

  .hero-mark:hover > span,
  .hero-mark:focus-visible > span {
    background-size: 100% 100%;
    color: var(--color-bg);
  }

  @media (min-width: 1024px) {
    .hero-mark {
      display: block;
    }
  }

  .section {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .section-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .section-title {
    margin-bottom: var(--space-1);
  }

  .section-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .section-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    white-space: nowrap;
  }

  .writing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Mobile: release the single-screen lock so a tall hero scrolls instead of
     clipping (see BaseLayout's matching .is-full-bleed override). */
  @media (max-width: 639.98px) {
    .hero-section {
      overflow: visible;
      gap: var(--space-8);
      padding: var(--space-6) 0 var(--space-10);
    }

    .hero-main {
      justify-content: flex-start;
    }

    .availability-pill {
      margin-bottom: var(--space-6);
    }

    /* Social links live in the menu overlay on mobile */
    .hero-bottom :global(.hero-social) {
      display: none;
    }
  }
</style>
