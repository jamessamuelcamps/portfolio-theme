---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingCard from '../components/WritingCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const allWriting = await getCollection('writing');
const recentWriting = allWriting
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <div class="container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge">Product Designer</div>
      <h1 class="hero-headline">
        Designing clear, human-centered digital products & design systems.
      </h1>
      <p class="hero-subtext">
        I am James Samuel Camps, a product designer based in the UK. I specialize in untangling complex systems, building robust multi-platform component libraries, and designing intuitive interfaces for fintech, enterprise, and mobile apps.
      </p>
      <div class="hero-actions">
        <a href="/work" class="btn btn-primary">View Case Studies</a>
        <a href="#about" class="btn btn-outline">About Me</a>
      </div>
    </section>

    <!-- Featured Case Studies Section -->
    <section class="section" id="work">
      <div class="section-header">
        <div>
          <h2 class="section-title">Selected Work</h2>
          <p class="section-description">Deep dives into recent product design challenges, processes, and business outcomes.</p>
        </div>
        <a href="/work" class="section-link">View All Work →</a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <!-- Recent Writing Section -->
    <section class="section" id="writing">
      <div class="section-header">
        <div>
          <h2 class="section-title">Writing & Thoughts</h2>
          <p class="section-description">Observations on design tokens, systems thinking, and product craft.</p>
        </div>
        <a href="/writing" class="section-link">View All Writing →</a>
      </div>

      <div class="writing-list">
        {recentWriting.map((post) => (
          <WritingCard post={post} />
        ))}
      </div>
    </section>

    <!-- About / Contact Section -->
    <section class="section" id="about">
      <div class="about-card">
        <h2 class="about-title">Let’s build something thoughtful together</h2>
        <p class="about-text">
          Whether you’re establishing a zero-to-one design system, evolving a complex enterprise workflow, or looking for product design leadership, I’d love to chat.
        </p>
        <div class="about-actions">
          <a href="mailto:james@example.com" class="btn btn-primary">Say Hello</a>
          <a href="https://github.com/jamessamuelcamps" target="_blank" rel="noopener noreferrer" class="btn btn-outline">GitHub Profile</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero-section {
    padding: var(--space-12) 0 var(--space-16);
    max-width: 780px;
  }

  .hero-badge {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .hero-headline {
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-tight);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .hero-headline {
      font-size: var(--font-size-5xl);
    }
  }

  .hero-subtext {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .section {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .section-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .section-title {
    margin-bottom: var(--space-1);
  }

  .section-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .section-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .writing-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    max-width: 720px;
  }

  .about-title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-3);
  }

  .about-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
