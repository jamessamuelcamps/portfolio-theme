---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import DisplayQuote from '../components/DisplayQuote.astro';
import DotField from '../components/DotField.astro';
import { site } from '../config';
---

<BaseLayout fullBleed>
  {/* Dot field behind the page; nav hover gathers it into shapes. */}
  <DotField />

  <div class="container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-main">
        <DisplayQuote spin />
      </div>

      <div class="hero-bottom">
        <div class="hero-bio">
          <p>
            <span>A couple of short paragraphs introducing you and what you do — this
            is the first thing a visitor reads after the headline quote above,
            so keep it plain-spoken and specific to your own work.</span>
          </p>
          <p>
            <span>Mention a project you’re building, a specialism, or anything else
            worth a link here. Edit this copy directly in <code>src/pages/index.astro</code>.</span>
          </p>
        </div>

        <SocialLinks class="hero-social" emailLabel="Email" variant="column" />
      </div>

      {site.themeCredit && (
        <a
          class="hero-mark"
          href={site.themeCredit.href}
          target="_blank"
          rel="noopener noreferrer"
        ><span>{site.themeCredit.label}</span></a>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding: var(--space-8) 0 var(--space-12);
  }

  .hero-main {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1144px;
  }

  /* Display quote, cite and spin pill: DisplayQuote.astro (shared with the
     About page) + .display-quote in global.css. */

  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .hero-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .hero-bio {
    max-width: 560px;
    font-size: var(--font-size-base);
    color: var(--color-text);
  }

  .hero-bio p + p {
    margin-top: var(--space-4);
  }

  .highlight-link {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: var(--font-weight-medium);
  }

  .highlight-link:hover {
    color: var(--color-text-secondary);
  }

  .hero-mark {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    display: none;
  }

  .hero-mark > span {
    display: inline-block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    padding: 0.15em 0.3em;
    background-color: var(--color-bg); /* keeps the label clear of the dot field */
    /* Marker sweep: a text-colour highlight grows from the start of the label
       (screen-bottom, after the 180° rotation) to the end on hover, glyphs
       flipping to the page colour — the inverted highlight from the hero quote
       and card titles, revealed like a marker stroke. Directional like
       .marker-link: --sweep-from is in the span's own rotated frame, so 0%
       is screen-bottom. */
    background-image: linear-gradient(var(--color-text), var(--color-text));
    background-repeat: no-repeat;
    background-position: 50% var(--sweep-from, 0%);
    background-size: 100% 0%;
    transition:
      background-size var(--motion-base) var(--ease-precise),
      color var(--motion-base) var(--ease-precise);
  }

  /* Also overrides the global `a:hover` underline on the anchor itself. */
  .hero-mark:hover,
  .hero-mark:focus-visible {
    text-decoration: none;
  }

  .hero-mark:hover > span,
  .hero-mark:focus-visible > span {
    background-size: 100% 100%;
    color: var(--color-bg);
  }

  @media (min-width: 1024px) {
    .hero-mark {
      display: block;
    }
  }

  /* Mobile: release the single-screen lock so a tall hero scrolls instead of
     clipping (see BaseLayout's matching .is-full-bleed override). */
  @media (max-width: 639.98px) {
    .hero-section {
      overflow: visible;
      gap: var(--space-8);
      padding: var(--space-6) 0 var(--space-10);
    }

    .hero-main {
      justify-content: flex-start;
    }

    /* Social links live in the menu overlay on mobile */
    .hero-bottom :global(.hero-social) {
      display: none;
    }
  }
</style>
