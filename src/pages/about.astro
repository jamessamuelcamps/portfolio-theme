---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---

<BaseLayout
  title={`About · ${site.name}`}
  description={`${site.role} — background, approach and how I work.`}
>
  <div class="container">
    <header class="about-header">
      <h1 class="display-quote">
        <span>“A short, memorable line someone once said about working with you.”</span>
      </h1>
      <p class="display-quote-cite">— Their name, their role</p>
    </header>

    <div class="about-grid">
      <p class="about-standfirst statement">
        A one-paragraph introduction: who you are, roughly how long you've been doing this, and the kind of work you focus on. Currently based wherever you are, open to whatever you're open to, and building whatever else is worth a mention — like <a href="#" target="_blank" rel="noopener noreferrer">a side project</a>.
      </p>

      <section class="about-row">
        <div class="about-row-band">
          <span class="about-row-num">01 —</span>
        </div>
        <div class="about-row-head">
          <h2 class="about-row-title">Background & Mindset</h2>
        </div>
        <div class="about-row-body prose">
          <p>
            A short story about how you got into this line of work — the more
            unusual the path, the better it reads. What did it teach you that
            still shapes how you work today?
          </p>
          <ul class="about-highlights statement-list">
            <li>A principle you hold onto</li>
            <li>Another one, stated just as plainly</li>
          </ul>
          <p>
            A closing paragraph connecting that background to the kind of
            problems you solve now.
          </p>
        </div>
      </section>

      <section class="about-row">
        <div class="about-row-band">
          <span class="about-row-num">02 —</span>
        </div>
        <div class="about-row-head">
          <h2 class="about-row-title">Approach to Work</h2>
        </div>
        <div class="about-row-body prose">
          <p>
            A paragraph or two on how you like to collaborate — with a team,
            with stakeholders, with clients. What do people who've worked with
            you before tend to say about that?
          </p>
          <p>
            A second paragraph going a layer deeper — feedback style, how you
            handle disagreement, how hands-on you like to be.
          </p>
          <ul class="about-highlights statement-list">
            <li>A short, quotable belief about how you work</li>
            <li>Another one</li>
            <li>A third, if you've got one worth keeping</li>
          </ul>
        </div>
      </section>

      <section class="about-row">
        <div class="about-row-band">
          <span class="about-row-num">03 —</span>
        </div>
        <div class="about-row-head">
          <h2 class="about-row-title">How I Operate</h2>
        </div>
        <div class="about-row-body prose">
          <h3>A named principle</h3>
          <p>
            A short paragraph unpacking it — what it means in practice, and
            why it matters to the work you do.
          </p>

          <h3>Another named principle</h3>
          <p>
            Same shape: name it, then explain what it looks like day to day.
          </p>

          <h3>A third, if useful</h3>
          <p>
            Three subsections here mirrors the original layout — feel free to
            add, remove, or rename to fit how you actually think about your
            own practice.
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-header {
    max-width: 1200px;
    margin: 0 auto var(--space-16);
  }

  /* Display quote + cite type live in global.css (.display-quote /
     .display-quote-cite) so the homepage and About page stay in sync. */

  /* Centred 12-col container; the label + copy columns sit inset from both edges */
  .about-grid {
    --section-gap: calc(var(--space-16) + var(--space-8));
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: 0;
    max-width: 1200px;
    margin-inline: auto;
  }

  /* .statement / .statement-list carry the weight + tracking (see global.css) */
  /* Lead paragraph: statement family, no em-dash marker, one step up from a
     plain statement (xl vs lg); grows to 3xl on the wide layout. */
  .about-standfirst {
    grid-column: 1 / -1;
    margin-bottom: var(--section-gap);
    padding-left: 0;
    font-size: var(--font-size-xl);
  }

  .about-standfirst::before {
    content: none;
  }

  .about-standfirst a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .about-highlights {
    margin: var(--space-6) 0;
  }

  .about-row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
  }

  .about-row + .about-row {
    margin-top: var(--section-gap);
  }

  /* Number band — its own full-width row above the two columns, with a
     stroke beneath. Mirrors .cs-section-band on the case studies. */
  .about-row-band {
    grid-column: 1 / -1;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .about-row-head {
    grid-column: 1 / -1;
    margin-bottom: var(--space-4);
  }

  .about-row-num {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .about-row-title {
    font-size: var(--font-size-2xl);
    margin: 0;
  }

  .about-row-body {
    grid-column: 1 / -1;
  }

  .about-row-body,
  .about-row-body p {
    color: var(--color-text);
  }

  .about-row-body > :first-child {
    margin-top: 0;
  }

  .about-row-body > :last-child {
    margin-bottom: 0;
  }

  /* While the head + body are stacked (below the 768px two-column split), a
     body that opens on an in-prose heading sits right under the 2xl section
     title — add a little air so the two titles don't run together. */
  @media (max-width: 767.98px) {
    .about-row-body > h2:first-child,
    .about-row-body > h3:first-child,
    .about-row-body > h4:first-child {
      margin-top: var(--space-3);
    }
  }

  @media (min-width: 768px) {
    .about-grid {
      --section-gap: calc(var(--space-24) + var(--space-6));
    }

    .about-standfirst {
      grid-column: 1 / 11;
      font-size: var(--font-size-3xl);
    }

    .about-row-head {
      grid-column: 1 / 4;
      margin-bottom: 0;
    }

    .about-row-body {
      grid-column: 4 / 11;
    }
  }
</style>
