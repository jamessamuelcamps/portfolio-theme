---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found · James Samuel Camps" description="The page you are looking for does not exist.">
  <div class="container-prose not-found">
    <span class="error-code">404</span>
    <h1 class="error-title">Page not found</h1>
    <p class="error-message">
      The page you're looking for might have been moved, renamed, or doesn't exist.
    </p>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">Return Home</a>
      <a href="/work" class="btn btn-outline">View Work</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: var(--space-16) var(--space-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-code {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .error-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-3);
  }

  .error-message {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    max-width: 480px;
  }

  .error-actions {
    display: flex;
    gap: var(--space-3);
  }
</style>

