---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  fullBleed?: boolean;
  noindex?: boolean;
}

const {
  title = 'James Samuel-Camps · Lead Product Designer',
  description = 'Product design portfolio - case studies in fintech, digital banking and user research.',
  fullBleed = false,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored === 'light' || stored === 'dark'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body class:list={{ 'is-full-bleed': fullBleed }}>
    <Header />
    <main id="main-content" class:list={{ 'full-bleed': fullBleed }}>
      <slot />
    </main>
    {!fullBleed && <Footer />}

    <script>
      // Assemble mailto: links client-side so the address is never in the static HTML.
      document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((el) => {
        const user = el.dataset.emailUser;
        const domain = el.dataset.emailDomain;
        if (!user || !domain) return;
        const address = `${user}@${domain}`;
        el.setAttribute('href', `mailto:${address}`);
        el.textContent = el.dataset.emailLabel || address;
      });
    </script>
  </body>
</html>

<style>
  body.is-full-bleed {
    height: 100svh;
    min-height: 100svh;
    overflow: hidden;
  }

  #main-content {
    flex: 1;
    padding: var(--space-8) 0 var(--space-16);
  }

  #main-content.full-bleed {
    padding: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
</style>
