---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, client, heroImage, heroImageAlt, heroLayout, draft } = project.data;

// Titles are authored as "Feature • Client"; the header shows the client in
// the eyebrow and the feature on its own.
const displayTitle = title.split('•')[0].trim();
---

<BaseLayout title={`${title} · James Samuel Camps`} description={description} noindex={draft}>
  <article class="case-study" data-project={project.id}>
    <div class="container">
      <nav class="back-nav" aria-label="Breadcrumb">
        <a href="/work" class="back-link">
          <span aria-hidden="true">←</span>
          <span>Back to Work</span>
        </a>
      </nav>

      <header class="case-study-header">
        {client && <span class="case-study-eyebrow">{client}</span>}
        <h1 class="case-study-title">{displayTitle}</h1>
        <p class="case-study-lead">{description}</p>
      </header>
    </div>

    {heroImage && (
      <figure class:list={['case-study-hero', `case-study-hero--${heroLayout}`]}>
        <Image
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="case-study-hero-image"
          widths={[720, 1080, 1440, 1920]}
          sizes={heroLayout === 'wide' ? '(min-width: 1180px) 1140px, 100vw' : '(min-width: 760px) 720px, 100vw'}
        />
      </figure>
    )}

    <div class="container">
      <div class="prose cs-body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Header, hero and body all align to the same centred measure */
  .back-nav,
  .case-study-header {
    max-width: var(--wide-max);
    margin-inline: auto;
  }

  .back-nav {
    margin-bottom: var(--space-8);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .case-study-header {
    margin-bottom: var(--space-4);
  }

  /* Same kicker treatment as the work-card eyebrow and .cs-labelled-label. */
  .case-study-eyebrow {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .case-study-title {
    font-size: var(--font-size-5xl);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-4);
  }

  .case-study-lead {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  /* .meta-grid* now lives in global.css (shared with the Credits component) */
</style>

