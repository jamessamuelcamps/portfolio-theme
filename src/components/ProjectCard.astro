---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, role, client, timeline, tags } = project.data;
---

<article class="project-card">
  <a href={`/work/${project.id}`} class="project-card-link">
    <div class="project-header">
      <div class="project-meta-top">
        {client && <span class="project-client">{client}</span>}
        {role && <span class="project-role">{role}</span>}
        {timeline && <span class="project-timeline">{timeline}</span>}
      </div>
      <h3 class="project-title">{title}</h3>
    </div>

    <p class="project-description">{description}</p>

    {tags && tags.length > 0 && (
      <div class="badges-group project-tags">
        {tags.map((tag) => (
          <span class="badge">{tag}</span>
        ))}
      </div>
    )}

    <div class="project-cta">
      <span>Read Case Study</span>
      <span class="arrow" aria-hidden="true">→</span>
    </div>
  </a>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border-strong);
    transition: background-color var(--transition-base), color var(--transition-base);
  }

  .project-card:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .project-card:hover .badge,
  .project-card:hover .project-meta-top,
  .project-card:hover .project-client,
  .project-card:hover .project-title,
  .project-card:hover .project-description,
  .project-card:hover .project-cta {
    color: inherit;
  }

  .project-card:hover .badge {
    border-color: var(--color-bg);
  }

  .project-card-link {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .project-header {
    margin-bottom: var(--space-3);
  }

  .project-meta-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .project-client {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
  }

  .project-role::before, .project-timeline::before {
    content: '·';
    margin-right: var(--space-2);
  }

  .project-title {
    font-size: var(--font-size-xl);
    color: var(--color-text);
    margin-bottom: 0;
  }

  .project-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .project-tags {
    margin-bottom: var(--space-5);
  }

  .project-cta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    margin-top: auto;
  }

  .arrow {
    color: inherit;
  }
</style>

