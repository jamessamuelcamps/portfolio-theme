---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, client } = project.data;

// Titles are authored as "Feature • Client"; the card shows only the feature.
const displayTitle = title.split('•')[0].trim();
---

<article class="project-card">
  <a href={`/work/${project.id}`} class="project-card-link">
    {client && <span class="project-client">{client}</span>}
    <h3 class="project-title"><span>{displayTitle}</span></h3>
    <p class="project-description"><span>{description}</span></p>
  </a>
</article>

<style>
  /* Background, title and subtitle treatment mirror the case-study Card
     (.cs-card in global.css): a fine dot field for the panel, a per-line
     highlight hugging the words so they stay legible over it. */
  .project-card {
    background-color: var(--color-bg);
    background-image: radial-gradient(var(--color-dot) 0.75px, transparent 0.75px);
    background-size: 6px 6px;
    background-position: center;
  }

  .project-card-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-6);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* Matches the case-study "The Brief" kicker (.cs-labelled-label). */
  .project-client {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .project-title {
    align-self: flex-start;
    max-width: 100%;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin-bottom: 0;
  }

  /* No negative margin-left here (unlike .cs-card-title): the chip sits a
     hair in from the card edge so its right side never bleeds past the
     content box. */
  .project-title span {
    display: inline;
    background-color: var(--color-text);
    color: var(--color-bg);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0.12em 0.3em;
  }

  .project-description {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--color-text);
    margin-bottom: 0;
  }

  .project-description span {
    display: inline;
    background-color: var(--color-bg);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0.12em 0.3em;
    margin-left: -0.3em;
  }
</style>
