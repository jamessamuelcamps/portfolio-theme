---
/**
 * ProtoStage — an animated UI demo in a case study. The demo's own markup
 * (one element marked data-proto-screen) goes in the slot, authored at a
 * fixed design size and scaled to fit the figure. A timeline sets data-*
 * attributes on that screen element over time; the demo's CSS reacts to
 * them (transitions do the motion). Taps and swipes show a press ring on
 * a target.
 *
 * Plays in a loop while in view: at the end the device (the element marked
 * data-proto-fade, or else the screen) fades out, the demo snaps back to its
 * start and fades in again, so a timeline ends where its story does
 * (loopFade={false} for a demo whose end is its start). Demos given the
 * same sync group (say, the figures of one grid) share a clock: one that
 * starts playing picks up where a playing peer is.
 * Pause/play and chapter controls sit in the
 * slug line. Under reduced motion it never autoplays: it rests on the first
 * chapter's key frame and the chapters step between key frames.
 */
import type { ProtoChapter, ProtoEntry } from './protos/types';

interface Props {
  /** Design size of the screen in px; the stage scales it to fit */
  width: number;
  height: number;
  timeline: ProtoEntry[];
  /** loop length in ms */
  duration: number;
  /** Steps to jump between; leave empty for a GIF-style loop */
  chapters?: ProtoChapter[];
  /** With no chapters: the frame shown when paused or under reduced motion */
  rest?: number;
  /** Accessible description of what the demo shows */
  label: string;
  caption?: string;
  /** Width tier — see docs/case-study-components.md */
  tier?: 'prose' | 'wide';
  /** Fade the device out and in at the loop's end (default true) */
  loopFade?: boolean;
  /** Demos in the same group play in step */
  sync?: string;
}

const { width, height, timeline, duration, chapters = [], rest = 0, label, caption, tier = 'wide', loopFade = true, sync } = Astro.props;
const widthClass = tier === 'wide' ? 'bleed-wide' : null;
const config = JSON.stringify({ width, timeline, duration, chapters, rest, loopFade, sync });
---

<figure class:list={['cs-figure cs-proto', widthClass]} data-proto={config}>
  <div class="cs-proto-stage" style={`aspect-ratio: ${width} / ${height}`} role="img" aria-label={label}>
    <div class="cs-proto-canvas" style={`width: ${width}px; height: ${height}px`} aria-hidden="true">
      <slot />
      <span class="cs-proto-tap"></span>
    </div>
  </div>
  <div class="cs-proto-foot">
    {caption && <figcaption class="cs-figure-caption">{caption}</figcaption>}
    <div class="cs-proto-controls">
      <button type="button" class="cs-proto-toggle" data-proto-toggle aria-label="Pause animation">
        <svg class="cs-proto-icon-pause" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><rect x="1.5" y="1" width="2.5" height="8" fill="currentColor" /><rect x="6" y="1" width="2.5" height="8" fill="currentColor" /></svg>
        <svg class="cs-proto-icon-play" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1v8l7-4z" fill="currentColor" /></svg>
      </button>
      {chapters.map((c, i) => (
        <button type="button" class="cs-proto-chapter" data-proto-chapter={i}>
          <span>{String(i + 1).padStart(2, '0')} {c.label}</span>
          <span class="cs-proto-progress" aria-hidden="true"></span>
        </button>
      ))}
    </div>
  </div>
</figure>

<style>
  .cs-proto-stage {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .cs-proto-canvas {
    position: absolute;
    top: 0;
    left: 0;
    transform: scale(var(--s, 1));
    transform-origin: 0 0;
  }

  /* Press ring: a soft disc that lands on the target, dips and lifts off. */
  .cs-proto-tap {
    position: absolute;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    /* Light disc, dark edge: reads on a filled button and on bare canvas. */
    background: rgb(255 255 255 / 0.45);
    box-shadow: 0 0 0 1px rgb(12 12 14 / 0.4), 0 1px 4px rgb(12 12 14 / 0.25);
    opacity: 0;
    pointer-events: none;
    z-index: 100;
  }

  .cs-proto-tap.is-tapping {
    animation: proto-tap 700ms var(--ease-precise) both;
  }

  @keyframes proto-tap {
    0% { opacity: 0; transform: scale(1.6); }
    25% { opacity: 1; transform: scale(1); }
    45% { opacity: 1; transform: scale(0.82); }
    100% { opacity: 0; transform: scale(1.1); }
  }

  /* Swipe: press, drag by --dx/--dy, lift. */
  .cs-proto-tap.is-swiping {
    animation: proto-swipe var(--ms, 900ms) linear both;
  }

  @keyframes proto-swipe {
    0% { opacity: 0; transform: scale(1.6); animation-timing-function: var(--ease-precise); }
    15% { opacity: 1; transform: scale(0.86); animation-timing-function: var(--ease-standard); }
    85% { opacity: 1; transform: translate(var(--dx), var(--dy)) scale(0.86); animation-timing-function: var(--ease-precise); }
    100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(1.1); }
  }

  .cs-proto-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2) var(--space-6);
    margin-top: calc(var(--crop-gap) + var(--crop-len) + var(--space-2));
  }

  .case-study .cs-proto-foot .cs-figure-caption {
    margin-top: 0;
  }

  .cs-proto-controls {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    font-family: "DM Mono", var(--font-mono);
    font-size: var(--font-size-xs);
    line-height: 1.5;
  }

  .cs-proto-controls button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    cursor: pointer;
    transition: color var(--motion-base) var(--ease-precise);
  }

  .cs-proto-controls button:hover,
  .cs-proto-chapter.is-active {
    color: var(--color-text);
  }

  .cs-proto-toggle {
    display: inline-flex;
    align-items: center;
    height: 1.5em;
  }

  .cs-proto-icon-play,
  .is-paused .cs-proto-icon-pause {
    display: none;
  }

  .is-paused .cs-proto-icon-play {
    display: block;
  }

  .cs-proto-chapter {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  /* Hairline under each chapter; the active one fills as it plays. */
  .cs-proto-progress {
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(currentColor, currentColor) 0 0 / calc(var(--p, 0) * 100%) 100% no-repeat,
      var(--color-border);
  }

  /* The loop's end: the device fades out, and in again from the start. */
  :global(.cs-proto-canvas.is-ending [data-proto-fade]) {
    animation: proto-out 400ms var(--ease-standard) both;
  }

  :global(.cs-proto-canvas.is-starting [data-proto-fade]) {
    animation: proto-in 400ms var(--ease-standard) both;
  }

  @keyframes proto-out {
    to { opacity: 0; }
  }

  @keyframes proto-in {
    from { opacity: 0; }
  }

  /* Seeking: jump straight to a frame, no motion in between. Global so it
     reaches the demo's own (differently scoped) markup. */
  :global(.cs-proto-canvas.is-seeking),
  :global(.cs-proto-canvas.is-seeking *) {
    transition: none !important;
  }
</style>

<script>
  import type { ProtoChapter, ProtoEntry } from './protos/types';

  interface Config {
    width: number;
    timeline: ProtoEntry[];
    duration: number;
    chapters: ProtoChapter[];
    rest: number;
    loopFade: boolean;
    sync?: string;
  }

  // Sync groups: each member's current time, while it plays.
  const groups = new Map<string, Set<{ playing: () => boolean; time: () => number }>>();

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-proto]')) {
    const cfg: Config = JSON.parse(root.dataset.proto!);
    const stage = root.querySelector<HTMLElement>('.cs-proto-stage')!;
    const canvas = root.querySelector<HTMLElement>('.cs-proto-canvas')!;
    const screen = root.querySelector<HTMLElement>('[data-proto-screen]')!;
    const ring = root.querySelector<HTMLElement>('.cs-proto-tap')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-proto-toggle]')!;
    const chapterEls = [...root.querySelectorAll<HTMLElement>('[data-proto-chapter]')];
    const timeline = [...cfg.timeline].sort((a, b) => a.at - b.at);
    if (!screen.querySelector('[data-proto-fade]')) screen.setAttribute('data-proto-fade', '');
    // The fade out starts this long before the loop ends.
    const ENDING = 500;

    let t = 0;
    let playing = false;
    let inView = false;
    // Paused by the viewer (or by reduced motion) — in-view doesn't override it.
    let held = reduce.matches;
    let last = 0;
    const peers = cfg.sync ? groups.get(cfg.sync) ?? groups.set(cfg.sync, new Set()).get(cfg.sync)! : null;
    peers?.add({ playing: () => playing, time: () => t });

    // Scaled down, a transform is fine. Scaled up, Safari stretches the
    // design-size bitmap of anything animating, so it blurs while it
    // moves: zoom instead, which lays out and draws at the real size.
    const canZoom = CSS.supports('zoom', '2');
    const scale = () => {
      const s = stage.clientWidth / cfg.width;
      const zoom = canZoom && s > 1;
      canvas.style.zoom = zoom ? String(s) : '';
      canvas.style.setProperty('--s', zoom ? '1' : String(s));
    };
    new ResizeObserver(scale).observe(stage);
    scale();

    const apply = (entry: ProtoEntry) => {
      for (const [k, v] of Object.entries(entry.set ?? {})) screen.setAttribute(`data-${k}`, v);
    };

    // Put the ring on a target's centre (plus an offset) and play a gesture.
    const gesture = (selector: string, kind: 'is-tapping' | 'is-swiping', ox = 0, oy = 0) => {
      const target = screen.querySelector<HTMLElement>(selector);
      if (!target) return;
      // Design px per rect px, from the canvas itself: right under a
      // transform or zoom, however the browser reports zoomed rects.
      const c = canvas.getBoundingClientRect();
      const r = target.getBoundingClientRect();
      const s = c.width / cfg.width;
      ring.style.left = `${(r.left + r.width / 2 - c.left) / s + ox}px`;
      ring.style.top = `${(r.top + r.height / 2 - c.top) / s + oy}px`;
      ring.classList.remove('is-tapping', 'is-swiping');
      void ring.offsetWidth;
      ring.classList.add(kind);
    };

    const swipe = ({ target, dx = 0, dy = 0, ox, oy, ms = 900 }: NonNullable<ProtoEntry['swipe']>) => {
      ring.style.setProperty('--dx', `${dx}px`);
      ring.style.setProperty('--dy', `${dy}px`);
      ring.style.setProperty('--ms', `${ms}ms`);
      gesture(target, 'is-swiping', ox, oy);
    };

    // Fire entries in (from, to]; taps only while playing.
    const run = (from: number, to: number) => {
      for (const e of timeline) {
        if (e.at <= from || e.at > to) continue;
        apply(e);
        if (e.tap) gesture(e.tap, 'is-tapping');
        if (e.swipe) swipe(e.swipe);
      }
    };

    const chapterAt = (time: number) => {
      let i = 0;
      cfg.chapters.forEach((c, j) => { if (c.at <= time) i = j; });
      return i;
    };

    const paint = () => {
      if (!cfg.chapters.length) return;
      const i = chapterAt(t);
      const start = cfg.chapters[i].at;
      const end = cfg.chapters[i + 1]?.at ?? cfg.duration;
      chapterEls.forEach((el, j) => {
        el.classList.toggle('is-active', j === i);
        el.style.setProperty('--p', j === i ? String(Math.min(1, (t - start) / (end - start))) : '0');
      });
    };

    // Jump to a time: fold every entry up to it, with transitions off.
    const seek = (time: number) => {
      canvas.classList.remove('is-ending', 'is-starting');
      canvas.classList.add('is-seeking');
      ring.classList.remove('is-tapping', 'is-swiping');
      for (const e of timeline) if (e.at <= time) apply(e);
      void canvas.offsetWidth;
      canvas.classList.remove('is-seeking');
      t = time;
      paint();
    };

    const frame = (now: number) => {
      if (!playing) return;
      const dt = Math.min(now - last, 100);
      last = now;
      const prev = t;
      t += dt;
      if (t >= cfg.duration) {
        // Faded out: back to the start without motion, then fade in.
        seek(t - cfg.duration);
        if (cfg.loopFade) canvas.classList.add('is-starting');
      } else {
        run(prev, t);
        if (cfg.loopFade && prev < cfg.duration - ENDING && t >= cfg.duration - ENDING) {
          canvas.classList.remove('is-starting');
          canvas.classList.add('is-ending');
        }
      }
      paint();
      requestAnimationFrame(frame);
    };

    const sync = () => {
      const should = inView && !held;
      root.classList.toggle('is-paused', held);
      toggle.setAttribute('aria-label', held ? 'Play animation' : 'Pause animation');
      if (should === playing) return;
      playing = should;
      if (playing) {
        // Join a playing peer where it is.
        const peer = peers && [...peers].find((p) => p.playing() && p.time() !== t);
        if (peer) seek(peer.time());
        last = performance.now();
        requestAnimationFrame(frame);
      }
    };

    toggle.addEventListener('click', () => {
      held = !held;
      sync();
    });

    chapterEls.forEach((el, i) => {
      el.addEventListener('click', () => {
        const c = cfg.chapters[i];
        seek(held ? c.key : c.at);
      });
    });

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    }, { threshold: 0.4 }).observe(stage);

    seek(held ? (cfg.chapters[0]?.key ?? cfg.rest) : 0);
    sync();
  }
</script>
