---
interface Props {
  /**
   * Fixed column count at ≥640px. Omit for the default responsive
   * behaviour (2 columns, 4 at ≥640px) — keeps every existing usage intact.
   */
  columns?: 1 | 2 | 3 | 4;
}

const { columns } = Astro.props;
---

<div class="stat-grid" data-columns={columns}>
  <slot />
</div>

<style>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gutter);
    margin: 2rem 0;
  }

  .stat-grid[data-columns='1'] {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .stat-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .stat-grid[data-columns='2'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-grid[data-columns='3'] {
      grid-template-columns: repeat(3, 1fr);
    }

    .stat-grid[data-columns='4'] {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
