---
interface Props {
  /** Fixed column count at desktop width */
  columns?: 2 | 3 | 4;
  /** Width tier — see docs/case-study-components.md */
  width?: 'prose' | 'wide';
}

const { columns, width = 'wide' } = Astro.props;
---

<div
  class:list={[
    'cs-stage-cards',
    columns && `cs-stage-cards--${columns}`,
    width === 'wide' && 'bleed-wide',
  ]}
>
  <slot />
</div>
