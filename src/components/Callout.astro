---
interface Props {
  type?: 'info' | 'tip' | 'note' | 'warning';
  title?: string;
}

const { type = 'info', title } = Astro.props;
---

<aside class:list={['callout', `callout-${type}`]}>
  {title && <div class="callout-title">{title}</div>}
  <div class="callout-content">
    <slot />
  </div>
</aside>

<style>
  .callout {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-border-strong);
    background-color: var(--color-surface-sunken);
    margin: var(--space-6) 0;
  }

  .callout-title {
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .callout-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .callout-info {
    background-color: var(--color-callout-info-bg);
    border-left-color: var(--color-callout-info-border);
  }

  .callout-info .callout-title {
    color: var(--color-callout-info-text);
  }

  .callout-tip {
    background-color: #f0fdf4;
    border-left-color: #86efac;
  }

  @media (prefers-color-scheme: dark) {
    .callout-tip {
      background-color: #052e16;
      border-left-color: #15803d;
    }
  }

  .callout-warning {
    background-color: #fffbeb;
    border-left-color: #fcd34d;
  }

  @media (prefers-color-scheme: dark) {
    .callout-warning {
      background-color: #451a03;
      border-left-color: #b45309;
    }
  }
</style>

