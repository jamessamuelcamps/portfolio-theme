---
interface Props {
  /** Headline metric, e.g. "46%" */
  figure: string;
  /** Short label, e.g. "Recipients" */
  title: string;
}

const { figure, title } = Astro.props;
---

<div class="cs-insight-card">
  <div class="cs-insight-figure">{figure}</div>
  <div class="cs-insight-title">{title}</div>
  <div class="cs-insight-problem"><slot name="problem" /></div>
  <div class="cs-insight-idea"><slot name="idea" /></div>
</div>
