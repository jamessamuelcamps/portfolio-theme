---
interface Props {
  /** Bold heading below the icon */
  title?: string;
}

const { title } = Astro.props;
const hasIcon = Astro.slots.has('icon');
---

<div class="cs-journey-stage">
  {hasIcon && <div class="cs-journey-stage-icon"><slot name="icon" /></div>}
  {title && <div class="cs-journey-stage-title">{title}</div>}
  <div class="cs-journey-stage-body"><slot /></div>
</div>
