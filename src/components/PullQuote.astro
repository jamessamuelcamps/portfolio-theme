---
interface Props {
  /** Person or source name */
  cite?: string;
  /** Their role / company, e.g. "Dojo" */
  role?: string;
  /** "testimonial" bumps the type size for a standalone client quote */
  variant?: 'quote' | 'testimonial';
}

const { cite, role, variant = 'quote' } = Astro.props;
const attribution = [cite, role].filter(Boolean).join(', ');
---

<figure class:list={['cs-pullquote', { 'cs-pullquote--testimonial': variant === 'testimonial' }]}>
  <blockquote class="cs-pullquote-text">
    <slot />
  </blockquote>
  {attribution && <figcaption class="cs-pullquote-attribution">— {attribution}</figcaption>}
</figure>
