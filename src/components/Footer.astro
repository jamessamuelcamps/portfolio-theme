---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-meta">
      <p class="copyright">© {currentYear} James Samuel-Camps. All rights reserved.</p>
    </div>

    <p class="footer-built">Built with Astro</p>

    <div class="footer-links">
      <a class="marker-link" data-email data-email-user="hello" data-email-domain="james-sc.co.uk">hello [at] james-sc [dot] co [dot] uk</a>
      <a href="https://www.linkedin.com/in/jamessc/" class="marker-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://www.instagram.com/james_sc/" class="marker-link" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://github.com/jamessamuelcamps" class="marker-link" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding: var(--space-5) 0;
    background-color: var(--color-bg);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: space-between;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .copyright {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .footer-built {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }
</style>
