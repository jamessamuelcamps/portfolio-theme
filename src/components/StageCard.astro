---
interface Props {
  /** Stage name, e.g. "Fact-find" */
  title: string;
}

const { title } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<div class="cs-stage-card">
  {hasMedia && (
    <div class="cs-stage-card-media">
      <slot name="media" />
    </div>
  )}
  <h3 class="cs-stage-card-title">{title}</h3>
  <div class="cs-stage-card-body">
    <slot />
  </div>
</div>
